# ============================================================================
# WORKSHOP CONFIGURATION
# ============================================================================

# Default model for all agents in the workshop
# Examples: "anthropic:claude-haiku-4-5", "openai:gpt-5-mini", "openai:gpt-4o"
# Can be overridden per-agent in factory functions
WORKSHOP_MODEL="anthropic:claude-haiku-4-5"

# ShopMind runtime mode. Keep single/deterministic by default.
# Set SHOPMIND_AGENT_MODE="multi" to use the V3 read-only multi-agent path.
# Set SHOPMIND_SUPERVISOR_ROUTER="llm" to route with WORKSHOP_MODEL and
# deterministic fallback when the model/provider is unavailable.
# SHOPMIND_AGENT_MODE="single"
# SHOPMIND_SUPERVISOR_ROUTER="deterministic"
# SHOPMIND_DEPLOYMENT_PROFILE="development"
# For the reproducible local core demo use the server-owned offline profile:
# SHOPMIND_DEPLOYMENT_PROFILE="offline-demo"
# SHOPMIND_AGENT_MODE="multi"
# SHOPMIND_SUPERVISOR_ROUTER="deterministic"
# SHOPMIND_AGENT_PLANNER="deterministic"
# Keep local development deterministic and independent of the lazy embedding
# model. Set true only when document evidence has been prepared locally.
# SHOPMIND_RECOMMENDATION_EVIDENCE_ENABLED="false"
# SHOPMIND_RAG_AGENT_TRANSPORT="in_process"
# SHOPMIND_OUTBOX_ENABLED="false"
# SHOPMIND_DEPLOYMENT_REPLICAS="1"
# SHOPMIND_TRUSTED_PROXY_AUTHENTICATION="false"
# SHOPMIND_RUNTIME_CLEANUP_SCHEDULED="false"
# SHOPMIND_RUNTIME_CLEANUP_EVIDENCE_PATH="artifacts/runtime-cleanup-evidence.json"
# SHOPMIND_RUNTIME_CLEANUP_EVIDENCE_MAX_AGE_SECONDS="90000"
# SHOPMIND_SERVICE_SLO_MIN_RUNS="20"
# SHOPMIND_SERVICE_SLO_SUCCESS_RATE_TARGET="0.99"
# SHOPMIND_SERVICE_SLO_P95_LATENCY_MS="5000"
# SHOPMIND_IDENTITY_PROVIDER="development_payload"
# SHOPMIND_IDENTITY_SIGNING_SECRET="replace-with-at-least-32-random-characters"
# SHOPMIND_IDENTITY_SIGNATURE_MAX_AGE_SECONDS="60"
# SHOPMIND_IDENTITY_SIGNATURE_CLOCK_SKEW_SECONDS="5"
# SHOPMIND_CHECKOUT_SIGNING_SECRET="replace-with-at-least-32-random-characters"
# SHOPMIND_CHECKOUT_TOKEN_TTL_SECONDS="900"
# SHOPMIND_GOVERNANCE_AUDIT_ENABLED="false"
# SHOPMIND_GOVERNANCE_AUDIT_ALERT_FAILURE_THRESHOLD="3"

# Embedding provider for document vectorstore
# Options: "huggingface" (default, local model, no API key) or "openai" (requires OPENAI_API_KEY)
# Note: Changing providers requires rebuilding the vectorstore:
#   python data/data_generation/build_vectorstore.py
# EMBEDDING_PROVIDER="huggingface"

# ============================================================================
# SHOPMIND V2 POSTGRESQL / PGVECTOR CONFIGURATION
# ============================================================================

# Local PostgreSQL + pgvector database started by docker-compose.yml.
# This is additive for V2 infrastructure work; existing V1 tools still read
# the SQLite database until the data migration and tool refactor are completed.
DATABASE_URL="postgresql+psycopg://retailpilot:retailpilot@127.0.0.1:5432/retailpilot?connect_timeout=5"
TEST_DATABASE_URL="postgresql+psycopg://retailpilot:retailpilot@127.0.0.1:5432/retailpilot_test?connect_timeout=5"
# Only the bootstrap/operator phase may use this administrator connection.
# It must target the same database as DATABASE_URL; the application never uses it.
# Required only when the target database does not already contain pgvector.
# POSTGRES_ADMIN_URL="postgresql+psycopg://postgres:<admin-password>@127.0.0.1:5432/retailpilot?connect_timeout=5"

# Transactional Outbox publisher. Keep disabled for normal API development;
# the RocketMQ SDK is installed only in the standalone publisher environment.
# SHOPMIND_OUTBOX_ENABLED="false"
# SHOPMIND_OUTBOX_ROCKETMQ_ENDPOINT="127.0.0.1:8081"
# SHOPMIND_OUTBOX_ROCKETMQ_TOPIC="shopmind-order-events-v1"
# SHOPMIND_OUTBOX_ROCKETMQ_ACCESS_KEY=""
# SHOPMIND_OUTBOX_ROCKETMQ_SECRET_KEY=""
# SHOPMIND_OUTBOX_LEASE_SECONDS="60"
# SHOPMIND_OUTBOX_BATCH_SIZE="10"
# SHOPMIND_OUTBOX_POLL_INTERVAL_SECONDS="1"
# SHOPMIND_OUTBOX_BASE_BACKOFF_SECONDS="5"
# SHOPMIND_OUTBOX_MAX_BACKOFF_SECONDS="900"
# SHOPMIND_OUTBOX_MAX_ATTEMPTS="12"

# Default dimension for sentence-transformers/all-mpnet-base-v2.
# If EMBEDDING_PROVIDER=openai with text-embedding-3-small, use 1536 instead.
VECTOR_DIMENSION="768"

# ============================================================================
# LANGSMITH CONFIGURATION
# ============================================================================

# Optional side-channel observability.  Keep disabled for normal local work,
# tests, and offline evaluation.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopmind-development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_SAMPLING_RATE=1.0
# Put a real Key only in the uncommitted local .env or a deployment Secret.

# ============================================================================
# MODEL PROVIDER API KEYS
# ============================================================================

# If using OpenAI 
OPENAI_API_KEY="<openai-api-key>"
OPENAI_BASE_URL="<openai-base-url>" # Optional, if different from the default 

# If using Azure OpenAI
AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
AZURE_OPENAI_API_VERSION=""

# If using Anthropic
ANTHROPIC_API_KEY="<anthropic-api-key>"

# If using AWS
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION_NAME=""
AWS_MODEL_ARN=""

# ============================================================================
# DEPLOYMENT CONFIGURATION (Optional)
# ============================================================================

# Payment deadline for newly created pending Orders (seconds; default 1800)
SHOPMIND_ORDER_PAYMENT_TTL_SECONDS="1800"

# LangGraph deployment URL for simulation system
# Only needed if running automated simulations against deployed graphs
# Example: "https://your-deployment.us.langgraph.app"
LANGGRAPH_DEPLOYMENT_URL=""
