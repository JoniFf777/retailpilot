{
  "name": "shopmind-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "build": "tsc -b && vite build",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "generate:api": "node scripts/generate-api-types.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.81.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.60.0",
    "react-router-dom": "7.6.2",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.0.10",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.29.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vite": "7.0.0",
    "vitest": "3.2.4"
  }
}
